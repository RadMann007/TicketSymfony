{% extends 'layout/dashboard.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block page_content %}
    {% set myRate = myTotal > 0 ? (myDone / myTotal * 100)|round : 0 %}
    {% set myOpenRate = myTotal > 0 ? (myOpen / myTotal * 100)|round : 0 %}
    {% set assignedDone = assignedTotal - assignedOpen %}
    {% set assignedRate = assignedTotal > 0 ? (assignedDone / assignedTotal * 100)|round : 0 %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set globalRate = globalTotal > 0 ? (globalDone / globalTotal * 100)|round : 0 %}
    {% endif %}

    <div class="mx-auto w-full max-w-6xl space-y-6 px-4 py-8">

        {# ─── En-tête ─── #}
        <section class="relative overflow-hidden rounded-2xl border bg-card p-6 shadow-sm sm:p-8">
            <div class="pointer-events-none absolute -right-20 -top-28 size-72 rounded-full bg-primary/10 blur-3xl"
                 aria-hidden="true"></div>
            <div class="pointer-events-none absolute -bottom-28 left-1/4 size-64 rounded-full bg-chart-2/10 blur-3xl"
                 aria-hidden="true"></div>

            <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
                <div class="max-w-xl space-y-5">
                    <span class="inline-flex items-center gap-1.5 rounded-full border bg-background/70 px-2.5 py-1 text-xs font-medium text-muted-foreground backdrop-blur">
                        <twig:ux:icon name="lucide:layout-dashboard" class="size-3" aria-hidden="true" />
                        Vue d'ensemble
                    </span>

                    <div>
                        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
                            Bonjour, {{ app.user.userIdentifier|split('@')|first|capitalize }}
                        </h1>
                        <p class="mt-2 text-sm text-muted-foreground">
                            {% if myTotal == 0 %}
                                Vous n'avez encore aucun ticket. Créez le premier pour démarrer.
                            {% elseif myOpen == 0 %}
                                Bravo, tous vos tickets sont terminés !
                            {% else %}
                                Vous avez <span class="font-medium text-foreground">{{ myOpen }}</span>
                                ticket{{ myOpen > 1 ? 's' : '' }} en cours sur
                                <span class="font-medium text-foreground">{{ myTotal }}</span>.
                            {% endif %}
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <twig:Button as="a" href="{{ path('ticket.new') }}" variant="default">
                            <twig:ux:icon name="lucide:plus" class="mr-2 size-4" aria-hidden="true" />
                            Nouveau ticket
                        </twig:Button>
                        <twig:Button as="a" href="{{ path('ticket.index') }}" variant="outline">
                            <twig:ux:icon name="lucide:list" class="mr-2 size-4" aria-hidden="true" />
                            Mes tickets
                        </twig:Button>
                        <twig:Button as="a" href="{{ path('ticket.export') }}" variant="ghost">
                            <twig:ux:icon name="lucide:download" class="mr-2 size-4" aria-hidden="true" />
                            Exporter
                        </twig:Button>
                    </div>
                </div>

                {# Anneau de complétion personnelle #}
                <div class="flex items-center gap-5 self-start rounded-xl border bg-background/70 p-4 backdrop-blur lg:self-auto lg:min-w-64">
                    <div class="relative flex size-24 shrink-0 items-center justify-center rounded-full"
                         style="background: conic-gradient(var(--color-primary) {{ myRate }}%, var(--color-muted) 0);">
                        <div class="flex size-20 flex-col items-center justify-center rounded-full bg-card">
                            <span class="text-xl font-semibold tabular-nums leading-none">{{ myRate }}%</span>
                        </div>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Complétion</p>
                        <p class="mt-1 text-sm text-muted-foreground">
                            <span class="font-semibold text-foreground">{{ myDone }}</span>
                            sur {{ myTotal }} ticket{{ myTotal > 1 ? 's' : '' }} terminé{{ myDone > 1 ? 's' : '' }}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        {# ─── Alerte échéances ─── #}
        {% if overdue > 0 %}
            <section class="flex flex-col gap-3 rounded-xl border border-destructive/30 bg-destructive/5 p-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-3">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-destructive/10 text-destructive">
                        <twig:ux:icon name="lucide:alarm-clock" class="size-5" aria-hidden="true" />
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-destructive">
                            {{ overdue }} ticket{{ overdue > 1 ? 's' : '' }} en retard
                        </p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            L'échéance est passée et le ticket n'est pas terminé.
                        </p>
                    </div>
                </div>
                <twig:Button as="a" href="{{ path('ticket.index', {overdue: 1, tri: 'due'}) }}" variant="destructive" size="sm">
                    Voir les tickets en retard
                </twig:Button>
            </section>
        {% endif %}

        {# ─── Stats personnelles ─── #}
        <section>
            <div class="mb-3 flex items-end justify-between">
                <div>
                    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Mes tickets</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Votre activité personnelle.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {# Total #}
                <div class="group flex flex-col justify-between rounded-xl border bg-card p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="text-xs font-medium text-muted-foreground">Total</p>
                            <p class="mt-2 text-3xl font-semibold leading-none tracking-tight tabular-nums">{{ myTotal }}</p>
                        </div>
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                            <twig:ux:icon name="lucide:ticket" class="size-5" aria-hidden="true" />
                        </span>
                    </div>
                    <div class="mt-5 space-y-2">
                        <div class="flex h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full bg-emerald-500" style="width: {{ myRate }}%"></div>
                            <div class="h-full bg-amber-500" style="width: {{ myOpenRate }}%"></div>
                        </div>
                        <p class="text-xs text-muted-foreground">
                            {{ myDone }} terminé{{ myDone > 1 ? 's' : '' }} · {{ myOpen }} en cours
                        </p>
                    </div>
                </div>

                {# En cours #}
                <div class="group flex flex-col justify-between rounded-xl border bg-card p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="text-xs font-medium text-muted-foreground">En cours</p>
                            <p class="mt-2 text-3xl font-semibold leading-none tracking-tight tabular-nums text-amber-600 dark:text-amber-500">{{ myOpen }}</p>
                        </div>
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-500">
                            <twig:ux:icon name="lucide:clock" class="size-5" aria-hidden="true" />
                        </span>
                    </div>
                    <div class="mt-5 space-y-2">
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-amber-500" style="width: {{ myOpenRate }}%"></div>
                        </div>
                        <p class="text-xs text-muted-foreground">{{ myOpenRate }}% de vos tickets</p>
                    </div>
                </div>

                {# Terminés #}
                <div class="group flex flex-col justify-between rounded-xl border bg-card p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="text-xs font-medium text-muted-foreground">Terminés</p>
                            <p class="mt-2 text-3xl font-semibold leading-none tracking-tight tabular-nums text-emerald-600 dark:text-emerald-500">{{ myDone }}</p>
                        </div>
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-500">
                            <twig:ux:icon name="lucide:check-circle" class="size-5" aria-hidden="true" />
                        </span>
                    </div>
                    <div class="mt-5 space-y-2">
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-emerald-500" style="width: {{ myRate }}%"></div>
                        </div>
                        <p class="text-xs text-muted-foreground">{{ myRate }}% de vos tickets</p>
                    </div>
                </div>

                {# Assignés à moi #}
                <div class="group flex flex-col justify-between rounded-xl border bg-card p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="text-xs font-medium text-muted-foreground">Assignés à moi</p>
                            <p class="mt-2 text-3xl font-semibold leading-none tracking-tight tabular-nums">{{ assignedTotal }}</p>
                        </div>
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                            <twig:ux:icon name="lucide:user" class="size-5" aria-hidden="true" />
                        </span>
                    </div>
                    <div class="mt-5 space-y-2">
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-primary" style="width: {{ assignedRate }}%"></div>
                        </div>
                        <p class="text-xs text-muted-foreground">
                            {{ assignedOpen }} en cours · {{ assignedDone }} terminé{{ assignedDone > 1 ? 's' : '' }}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        {# ─── Analyse ─── #}
        <section id="analytics">
            <div class="mb-3 flex items-end justify-between">
                <div>
                    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Analyse</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        {% if is_granted('ROLE_ADMIN') %}
                            Sur l'ensemble des tickets.
                        {% else %}
                            Sur vos tickets (créés ou assignés).
                        {% endif %}
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
                {# Temps moyen de résolution #}
                <div class="rounded-xl border bg-card p-5 shadow-sm">
                    <p class="text-xs font-medium text-muted-foreground">Temps moyen de résolution</p>
                    <p class="mt-2 text-3xl font-semibold leading-none tracking-tight tabular-nums">
                        {% if analytics.averageResolutionDays is not null %}
                            {{ analytics.averageResolutionDays|number_format(1, ',', ' ') }}
                            <span class="text-base font-medium text-muted-foreground">jours</span>
                        {% else %}
                            <span class="text-muted-foreground">—</span>
                        {% endif %}
                    </p>
                    <p class="mt-3 text-xs text-muted-foreground">
                        {% if analytics.resolvedCount > 0 %}
                            Sur {{ analytics.resolvedCount }} ticket{{ analytics.resolvedCount > 1 ? 's' : '' }}
                            terminé{{ analytics.resolvedCount > 1 ? 's' : '' }}.
                        {% else %}
                            Aucun ticket terminé pour le moment.
                        {% endif %}
                    </p>
                </div>

                {# Échéances respectées #}
                <div class="rounded-xl border bg-card p-5 shadow-sm">
                    <p class="text-xs font-medium text-muted-foreground">Échéances respectées</p>
                    <p class="mt-2 text-3xl font-semibold leading-none tracking-tight tabular-nums {{ analytics.onTimeRate is not null and analytics.onTimeRate < 70 ? 'text-destructive' : '' }}">
                        {% if analytics.onTimeRate is not null %}
                            {{ analytics.onTimeRate }}<span class="text-base font-medium text-muted-foreground">%</span>
                        {% else %}
                            <span class="text-muted-foreground">—</span>
                        {% endif %}
                    </p>
                    <p class="mt-3 text-xs text-muted-foreground">
                        {% if analytics.dueDateCount > 0 %}
                            {{ analytics.onTimeCount }} sur {{ analytics.dueDateCount }}
                            ticket{{ analytics.dueDateCount > 1 ? 's' : '' }} terminé{{ analytics.dueDateCount > 1 ? 's' : '' }}
                            avec une échéance.
                        {% else %}
                            Aucune échéance sur les tickets terminés.
                        {% endif %}
                    </p>
                </div>

                {# Répartition des tickets en cours #}
                <div class="rounded-xl border bg-card p-5 shadow-sm">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-xs font-medium text-muted-foreground">Tickets en cours</p>
                        <span class="text-xs font-semibold tabular-nums text-muted-foreground">{{ analytics.openTotal }}</span>
                    </div>

                    {% if analytics.openTotal > 0 %}
                        <div class="mt-4 space-y-3">
                            {% for item in analytics.openByPriority %}
                                <div>
                                    <div class="flex items-center justify-between gap-2">
                                        <twig:Badge variant="{{ item.priority.badgeVariant }}">{{ item.priority.label }}</twig:Badge>
                                        <span class="text-xs font-medium tabular-nums">{{ item.count }}</span>
                                    </div>
                                    <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-primary" style="width: {{ item.share }}%"></div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="mt-4 text-xs text-muted-foreground">Aucun ticket en cours.</p>
                    {% endif %}
                </div>
            </div>

            {# Créations vs résolutions #}
            <div class="mt-4 rounded-xl border bg-card p-5 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h3 class="text-base font-semibold">Créés vs résolus</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">8 dernières semaines.</p>
                    </div>
                    <div class="flex items-center gap-4 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1.5">
                            <span class="size-2.5 rounded-full bg-primary" aria-hidden="true"></span>
                            Créés
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="size-2.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                            Résolus
                        </span>
                    </div>
                </div>

                <div class="mt-6 flex items-end gap-2 sm:gap-3">
                    {% for week in analytics.weeks %}
                        <div class="flex min-w-0 flex-1 flex-col items-center gap-2">
                            <div class="flex h-32 w-full items-end justify-center gap-1">
                                <div class="w-2 rounded-t bg-primary sm:w-3"
                                     style="height: {{ week.created > 0 ? (week.created / analytics.maxWeekly * 100) : 0 }}%"
                                     title="{{ week.created }} créé{{ week.created > 1 ? 's' : '' }}"></div>
                                <div class="w-2 rounded-t bg-emerald-500 sm:w-3"
                                     style="height: {{ week.resolved > 0 ? (week.resolved / analytics.maxWeekly * 100) : 0 }}%"
                                     title="{{ week.resolved }} résolu{{ week.resolved > 1 ? 's' : '' }}"></div>
                            </div>
                            <span class="text-[10px] tabular-nums text-muted-foreground">{{ week.start|date('d/m') }}</span>
                            <span class="sr-only">{{ week.created }} créés, {{ week.resolved }} résolus</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ─── Derniers tickets + activité globale ─── #}
        <section class="grid grid-cols-1 gap-6 lg:grid-cols-3">

            {# Derniers tickets #}
            <div class="flex h-full flex-col overflow-hidden rounded-xl border bg-card shadow-sm {{ is_granted('ROLE_ADMIN') ? 'lg:col-span-2' : 'lg:col-span-3' }}">
                <div class="flex items-start justify-between gap-2 border-b px-5 py-4">
                    <div>
                        <h2 class="text-base font-semibold">Derniers tickets</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">Vos 5 tickets récents (créés ou assignés).</p>
                    </div>
                    <twig:Button as="a" href="{{ path('ticket.index') }}" variant="ghost" size="sm">
                        Tout voir
                        <twig:ux:icon name="lucide:chevron-right" class="ml-1 size-3.5" aria-hidden="true" />
                    </twig:Button>
                </div>

                {% if latest is empty %}
                    <div class="flex flex-1 flex-col items-center justify-center gap-3 px-6 py-12 text-center">
                        <twig:ux:icon name="lucide:inbox" class="size-12 text-muted-foreground/40" aria-hidden="true" />
                        <div>
                            <p class="text-sm font-medium">Aucun ticket pour le moment</p>
                            <p class="mt-1 text-xs text-muted-foreground">Vos derniers tickets apparaîtront ici.</p>
                        </div>
                        <twig:Button as="a" href="{{ path('ticket.new') }}" variant="outline" size="sm">
                            <twig:ux:icon name="lucide:plus" class="mr-1.5 size-4" aria-hidden="true" />
                            Créer un ticket
                        </twig:Button>
                    </div>
                {% else %}
                    <ul class="divide-y">
                        {% for ticket in latest %}
                            <li>
                                <a href="{{ path('ticket.edit', {id: ticket.id}) }}"
                                   class="group flex items-center gap-3 px-5 py-3.5 transition-colors hover:bg-muted/50">
                                    <span class="flex size-9 shrink-0 items-center justify-center rounded-full border bg-muted/40 text-muted-foreground transition-colors group-hover:bg-card group-hover:text-foreground">
                                        <twig:ux:icon name="lucide:ticket" class="size-4" aria-hidden="true" />
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-sm font-medium">{{ ticket.name }}</p>
                                        <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                            {{ ticket.createdAt ? ticket.createdAt|date('d/m/Y · H:i') : 'Date inconnue' }}
                                            {% if ticket.assignedTo %}
                                                · Assigné à {{ ticket.assignedTo.email }}
                                            {% endif %}
                                            {% if ticket.dueDate %}
                                                · <span class="{{ ticket.isOverdue ? 'font-medium text-destructive' : '' }}">échéance {{ ticket.dueDate|date('d/m/Y') }}</span>
                                            {% endif %}
                                        </p>
                                    </div>
                                    <twig:Badge variant="{{ ticket.priority.badgeVariant }}">{{ ticket.priority.label }}</twig:Badge>
                                    {% if ticket.isOverdue %}
                                        <twig:Badge variant="destructive">En retard</twig:Badge>
                                    {% elseif ticket.isDone %}
                                        <twig:Badge variant="success">Terminé</twig:Badge>
                                    {% else %}
                                        <twig:Badge variant="warning">En cours</twig:Badge>
                                    {% endif %}
                                    <twig:ux:icon name="lucide:chevron-right"
                                                  class="size-4 shrink-0 text-muted-foreground/40 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                {# Activité globale #}
                <div class="flex h-full flex-col overflow-hidden rounded-xl border bg-card shadow-sm">
                <div class="border-b px-5 py-4">
                    <h2 class="text-base font-semibold">Activité globale</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Tous les utilisateurs.</p>
                </div>

                <div class="flex flex-1 flex-col items-center justify-center gap-6 p-5">
                    <div class="relative flex size-40 shrink-0 items-center justify-center rounded-full"
                         style="background: conic-gradient(var(--color-primary) {{ globalRate }}%, var(--color-muted) 0);">
                        <div class="flex size-32 flex-col items-center justify-center rounded-full bg-card">
                            <span class="text-3xl font-semibold leading-none tabular-nums">{{ globalRate }}%</span>
                            <span class="mt-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">terminés</span>
                        </div>
                    </div>

                    <div class="grid w-full grid-cols-2 gap-3">
                        <div class="rounded-lg border bg-muted/30 p-3">
                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="size-2 rounded-full bg-amber-500"></span>
                                Ouverts
                            </div>
                            <p class="mt-1 text-xl font-semibold tabular-nums text-amber-600 dark:text-amber-500">{{ globalOpen }}</p>
                        </div>
                        <div class="rounded-lg border bg-muted/30 p-3">
                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                <span class="size-2 rounded-full bg-primary"></span>
                                Terminés
                            </div>
                            <p class="mt-1 text-xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-500">{{ globalDone }}</p>
                        </div>
                    </div>
                </div>

                    <div class="flex items-center justify-between border-t px-5 py-3 text-xs text-muted-foreground">
                        <span>Total</span>
                        <span class="font-semibold tabular-nums text-foreground">{{ globalTotal }} ticket{{ globalTotal > 1 ? 's' : '' }}</span>
                    </div>
                </div>
            {% endif %}
        </section>

        {# ─── Tickets par utilisateur ─── #}
        {% if is_granted('ROLE_ADMIN') and byOwner is not empty %}
            <section>
                <div class="overflow-hidden rounded-xl border bg-card shadow-sm">
                    <div class="flex items-start justify-between gap-2 border-b px-5 py-4">
                        <div>
                            <h2 class="text-base font-semibold">Tickets par utilisateur</h2>
                            <p class="mt-0.5 text-xs text-muted-foreground">Répartition et progression de chaque membre.</p>
                        </div>
                        <twig:Button as="a" href="{{ path('admin.user.index') }}" variant="ghost" size="sm">
                            <twig:ux:icon name="lucide:users" class="mr-1.5 size-3.5" aria-hidden="true" />
                            Gérer
                        </twig:Button>
                    </div>

                    <twig:Table>
                        <twig:Table:Header>
                            <twig:Table:Row>
                                <twig:Table:Head>Utilisateur</twig:Table:Head>
                                <twig:Table:Head class="w-20 text-center">Total</twig:Table:Head>
                                <twig:Table:Head class="w-24 text-center">Ouverts</twig:Table:Head>
                                <twig:Table:Head class="w-24 text-center">Terminés</twig:Table:Head>
                                <twig:Table:Head class="w-48">Progression</twig:Table:Head>
                            </twig:Table:Row>
                        </twig:Table:Header>
                        <twig:Table:Body>
                            {% for row in byOwner %}
                                {% set rowRate = row.total > 0 ? (row.done / row.total * 100)|round : 0 %}
                                <twig:Table:Row>
                                    <twig:Table:Cell>
                                        <div class="flex items-center gap-3">
                                            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">
                                                {{ row.email|slice(0, 1)|upper }}
                                            </span>
                                            <div class="min-w-0">
                                                <p class="truncate text-sm font-medium">{{ row.email }}</p>
                                                {% if row.ownerId == app.user.id %}
                                                    <p class="text-xs text-muted-foreground">Vous</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </twig:Table:Cell>
                                    <twig:Table:Cell class="text-center font-medium tabular-nums">{{ row.total }}</twig:Table:Cell>
                                    <twig:Table:Cell class="text-center">
                                        <twig:Badge variant="warning">{{ row.open }}</twig:Badge>
                                    </twig:Table:Cell>
                                    <twig:Table:Cell class="text-center">
                                        <twig:Badge variant="success">{{ row.done }}</twig:Badge>
                                    </twig:Table:Cell>
                                    <twig:Table:Cell>
                                        <div class="flex items-center gap-3">
                                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                                <div class="h-full rounded-full bg-primary" style="width: {{ rowRate }}%"></div>
                                            </div>
                                            <span class="w-9 shrink-0 text-right text-xs tabular-nums text-muted-foreground">{{ rowRate }}%</span>
                                        </div>
                                    </twig:Table:Cell>
                                </twig:Table:Row>
                            {% endfor %}
                        </twig:Table:Body>
                    </twig:Table>
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
