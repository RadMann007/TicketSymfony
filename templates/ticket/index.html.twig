{% extends 'layout/dashboard.html.twig' %}

{% block title %}Liste des tickets{% endblock %}

{% block page_content %}
    {% set filterParams = {
        q: q,
        priority: priority ? priority.value : null,
        overdue: overdue ? 1 : null,
        tri: sort != 'recent' ? sort : null,
        status: status != 'all' ? status : null,
        assignee: assignee,
        owner: owner,
        from: createdFrom ? createdFrom|date('Y-m-d') : null,
        to: createdTo ? createdTo|date('Y-m-d') : null,
    } %}
    <div class="mx-auto w-full max-w-6xl px-4 py-6">

        {# Messages flash #}
        {% for message in app.flashes('success') %}
            <twig:Alert class="mb-4 flex items-start gap-3 rounded-lg border border-green-200 bg-green-50 p-3 text-sm text-green-800">
                <twig:ux:icon name="lucide:info" class="size-4 shrink-0" />
                <twig:Alert:Description>{{ message }}</twig:Alert:Description>
            </twig:Alert>
        {% endfor %}

        {# En-tête #}
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-baseline gap-2.5">
                <h1 class="text-2xl font-semibold tracking-tight">Tickets</h1>
                <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium tabular-nums text-muted-foreground">
                    {{ pagination.getTotalItemCount() }}
                </span>
                {% if q %}
                    <span class="truncate text-sm text-muted-foreground">pour « {{ q }} »</span>
                {% endif %}
            </div>
            <div class="flex items-center gap-2">
                <twig:Button as="a" href="{{ path('ticket.export', filterParams) }}" variant="outline" size="sm">
                    <twig:ux:icon name="lucide:download" class="mr-1.5 size-3.5" />
                    Exporter
                </twig:Button>
                <twig:Button as="a" href="{{ path('ticket.new') }}" variant="default" size="sm">
                    <twig:ux:icon name="lucide:plus" class="mr-1.5 size-3.5" />
                    Nouveau ticket
                </twig:Button>
            </div>
        </div>

        {% set selectClass = 'h-9 min-w-0 truncate rounded-lg border border-input bg-transparent px-2.5 text-xs outline-none transition-colors focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 dark:bg-input/30' %}
        {% set advancedCount = (status != 'all' ? 1 : 0) + (assignee is not null ? 1 : 0) + (owner is not null ? 1 : 0) + (createdFrom or createdTo ? 1 : 0) %}
        {% set hasAdvanced = advancedCount > 0 %}
        {% set hasAnyFilter = q or priority or overdue or sort != 'recent' or hasAdvanced %}

        {# Recherche et filtres #}
        <form method="get" action="{{ path('ticket.index') }}"
              class="mb-4 min-w-0 overflow-hidden rounded-xl border bg-card shadow-sm">

            {# Barre principale : recherche, filtres rapides, actions #}
            <div class="flex min-w-0 flex-col gap-2 p-2 xl:flex-row xl:items-center">
                <div class="relative min-w-0 flex-1">
                    <twig:ux:icon name="lucide:search"
                                  class="pointer-events-none absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                    <twig:Input
                        name="q"
                        value="{{ q }}"
                        placeholder="Rechercher un ticket..."
                        class="h-9 w-full pl-8 text-sm"
                    />
                </div>

                <div class="flex min-w-0 flex-wrap items-center gap-2">
                    <label for="filter-priority" class="sr-only">Priorité</label>
                    <select id="filter-priority" name="priority"
                            class="{{ selectClass }} w-auto min-w-[8.5rem] flex-1 sm:flex-none">
                        <option value="">Toutes priorités</option>
                        {% for value, label in {'high': 'Haute', 'normal': 'Normale', 'low': 'Basse'} %}
                            <option value="{{ value }}" {{ priority and priority.value == value ? 'selected' }}>{{ label }}</option>
                        {% endfor %}
                    </select>

                    <label class="inline-flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-lg border border-input px-2.5 text-xs transition-colors hover:bg-muted/50 has-checked:border-destructive/40 has-checked:bg-destructive/5 has-checked:text-destructive">
                        <input type="checkbox" name="overdue" value="1" {{ overdue ? 'checked' }}
                               class="size-3.5 rounded border-input accent-destructive">
                        En retard
                    </label>

                    <label for="filter-sort" class="sr-only">Trier les tickets</label>
                    <select id="filter-sort" name="tri"
                            class="{{ selectClass }} w-auto min-w-[8.5rem] flex-1 sm:flex-none">
                        {% for value, label in sortOptions %}
                            <option value="{{ value }}" {{ sort == value ? 'selected' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="flex min-w-0 items-center justify-end gap-2 xl:ml-auto">
                    <twig:Button type="submit" size="sm" class="h-9">
                        <twig:ux:icon name="lucide:filter" class="mr-1.5 size-3.5" />
                        Filtrer
                    </twig:Button>

                    {% if hasAnyFilter %}
                        <twig:Button as="a" href="{{ path('ticket.index') }}" variant="ghost" size="sm" class="h-9"
                                     title="Réinitialiser les filtres">
                            <twig:ux:icon name="lucide:x" class="mr-1.5 size-3.5" />
                            Effacer
                        </twig:Button>
                    {% endif %}
                </div>
            </div>

            {# Filtres avancés : panneau dépliant pleine largeur, sous la barre principale #}
            <details class="group border-t bg-muted/20" {{ hasAdvanced ? 'open' }}>
                <summary class="flex cursor-pointer list-none select-none items-center gap-1.5 px-3 py-2 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted/40 hover:text-foreground [&::-webkit-details-marker]:hidden">
                    <twig:ux:icon name="lucide:chevron-right"
                                  class="size-3.5 shrink-0 transition-transform duration-150 group-open:rotate-90" />
                    Filtres avancés
                    {% if hasAdvanced %}
                        <twig:Badge variant="secondary" class="ml-0.5">{{ advancedCount }} actif{{ advancedCount > 1 ? 's' }}</twig:Badge>
                    {% endif %}
                    <span class="ml-auto hidden text-[11px] font-normal sm:inline">Statut · Assignation · Propriétaire · Période</span>
                </summary>

                <div class="border-t px-3 py-3">
                    <div class="grid min-w-0 grid-cols-1 gap-x-3 gap-y-3 sm:grid-cols-2 xl:grid-cols-4">
                        <div class="min-w-0 space-y-1.5">
                            <label for="filter-status" class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Statut</label>
                            <select id="filter-status" name="status" class="{{ selectClass }} w-full">
                                <option value="all" {{ status == 'all' ? 'selected' }}>Tous</option>
                                <option value="open" {{ status == 'open' ? 'selected' }}>En cours</option>
                                <option value="done" {{ status == 'done' ? 'selected' }}>Terminés</option>
                            </select>
                        </div>

                        <div class="min-w-0 space-y-1.5">
                            <label for="filter-assignee" class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Assigné à</label>
                            <select id="filter-assignee" name="assignee" class="{{ selectClass }} w-full">
                                <option value="">Tous</option>
                                <option value="none" {{ assignee == 'none' ? 'selected' }}>Non assignés</option>
                                {% for u in users %}
                                    <option value="{{ u.id }}" {{ assignee == u.id ? 'selected' }}>{{ u.email }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {% if isAdmin %}
                            <div class="min-w-0 space-y-1.5">
                                <label for="filter-owner" class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Propriétaire</label>
                                <select id="filter-owner" name="owner" class="{{ selectClass }} w-full">
                                    <option value="">Tous</option>
                                    {% for u in users %}
                                        <option value="{{ u.id }}" {{ owner == u.id ? 'selected' }}>{{ u.email }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}

                        <div class="min-w-0 space-y-1.5">
                            <span class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Créé entre</span>
                            <div class="grid min-w-0 grid-cols-2 gap-1.5">
                                <label class="min-w-0">
                                    <span class="sr-only">Date de début</span>
                                    <input type="date" name="from" value="{{ createdFrom ? createdFrom|date('Y-m-d') : '' }}"
                                           class="{{ selectClass }} w-full px-2">
                                </label>
                                <label class="min-w-0">
                                    <span class="sr-only">Date de fin</span>
                                    <input type="date" name="to" value="{{ createdTo ? createdTo|date('Y-m-d') : '' }}"
                                           class="{{ selectClass }} w-full px-2">
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 flex flex-wrap items-center justify-end gap-2 border-t pt-3">
                        {% if hasAnyFilter %}
                            <twig:Button as="a" href="{{ path('ticket.index') }}" variant="ghost" size="sm">
                                <twig:ux:icon name="lucide:x" class="mr-1.5 size-3.5" />
                                Réinitialiser
                            </twig:Button>
                        {% endif %}
                        <twig:Button type="submit" size="sm">
                            <twig:ux:icon name="lucide:filter" class="mr-1.5 size-3.5" />
                            Appliquer les filtres
                        </twig:Button>
                    </div>
                </div>
            </details>
        </form>

        {# Liste des tickets #}
        <div class="overflow-hidden rounded-xl border bg-card shadow-sm">
            {% if pagination.getTotalItemCount() == 0 %}
                <div class="flex flex-col items-center justify-center gap-3 px-6 py-14 text-center">
                    {% if hasAnyFilter %}
                        <twig:ux:icon name="lucide:search-x" class="size-10 text-muted-foreground/40" aria-hidden="true" />
                        <div>
                            <p class="text-sm font-medium">Aucun ticket ne correspond aux filtres</p>
                            <p class="mt-1 text-xs text-muted-foreground">Essayez d'élargir votre recherche.</p>
                        </div>
                        <twig:Button as="a" href="{{ path('ticket.index') }}" variant="outline" size="sm">
                            <twig:ux:icon name="lucide:x" class="mr-1.5 size-3.5" />
                            Réinitialiser
                        </twig:Button>
                    {% else %}
                        <twig:ux:icon name="lucide:inbox" class="size-10 text-muted-foreground/40" aria-hidden="true" />
                        <div>
                            <p class="text-sm font-medium">Aucun ticket pour le moment</p>
                            <p class="mt-1 text-xs text-muted-foreground">Créez votre premier ticket pour démarrer.</p>
                        </div>
                        <twig:Button as="a" href="{{ path('ticket.new') }}" variant="outline" size="sm">
                            <twig:ux:icon name="lucide:plus" class="mr-1.5 size-3.5" />
                            Créer le premier ticket
                        </twig:Button>
                    {% endif %}
                </div>
            {% else %}
                {# En-têtes de colonnes (desktop) #}
                <div class="hidden border-b bg-muted/30 px-4 py-2 text-[11px] font-medium uppercase tracking-wider text-muted-foreground lg:grid lg:grid-cols-[minmax(0,1fr)_6.5rem_7.5rem_5rem] lg:items-center lg:gap-4">
                    <span>Ticket</span>
                    <span>Statut</span>
                    <span>Échéance</span>
                    <span class="text-right">Actions</span>
                </div>

                <ul class="divide-y">
                    {% for ticket in pagination %}
                        <li class="group px-4 py-2.5 transition-colors hover:bg-muted/40">
                            <div class="flex flex-col gap-2 lg:grid lg:grid-cols-[minmax(0,1fr)_6.5rem_7.5rem_5rem] lg:items-center lg:gap-4">

                                {# Colonne principale #}
                                <div class="flex min-w-0 items-center gap-2.5">
                                    <span class="size-2 shrink-0 rounded-full {{ ticket.priority.value == 'high' ? 'bg-red-500' : (ticket.priority.value == 'normal' ? 'bg-amber-500' : 'bg-slate-400') }}"
                                          title="Priorité {{ ticket.priority.label|lower }}" aria-hidden="true"></span>

                                    <div class="min-w-0 flex-1">
                                        <a href="{{ path('ticket.edit', {id: ticket.id}) }}"
                                           class="block truncate text-sm font-medium leading-tight hover:underline">
                                            {{ ticket.name }}
                                        </a>

                                        <p class="mt-0.5 truncate text-xs text-muted-foreground"
                                           title="#{{ ticket.id }} · {{ ticket.createdAt|date('d/m/Y à H:i') }} · {{ ticket.owner.email }}{% if ticket.assignedTo %} → {{ ticket.assignedTo.email }}{% else %} · non assigné{% endif %}{% if ticket.comment %} · {{ ticket.comment }}{% endif %}">
                                            <span class="font-mono">#{{ ticket.id }}</span>
                                            <span class="mx-1 text-muted-foreground/50">·</span>{{ ticket.createdAt|date('d/m/Y') }}
                                            <span class="mx-1 text-muted-foreground/50">·</span>{{ ticket.owner.email }}
                                            {% if ticket.assignedTo %}
                                                <span class="mx-1 text-muted-foreground/50">→</span>{{ ticket.assignedTo.email }}
                                            {% else %}
                                                <span class="mx-1 text-muted-foreground/50">·</span><span class="text-muted-foreground/60">non assigné</span>
                                            {% endif %}
                                            {% if ticket.comment %}
                                                <span class="mx-1 text-muted-foreground/50">·</span><span class="italic">« {{ ticket.comment }} »</span>
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>

                                {# Statut, échéance, actions #}
                                <div class="flex flex-wrap items-center gap-2 lg:contents">

                                    <div class="flex items-center">
                                        {% if is_granted('TICKET_TOGGLE', ticket) %}
                                            <form method="post"
                                                  action="{{ path('ticket.toggle', {id: ticket.id}) }}"
                                                  class="inline-flex">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('toggle' ~ ticket.id) }}">
                                                {% for name, value in filterParams %}
                                                    {% if value is not null %}
                                                        <input type="hidden" name="_{{ name }}" value="{{ value }}">
                                                    {% endif %}
                                                {% endfor %}
                                                <button type="submit"
                                                        class="cursor-pointer border-0 bg-transparent p-0 transition-opacity hover:opacity-80"
                                                        title="Cliquer pour changer le statut">
                                                    {% if ticket.isDone %}
                                                        <twig:Badge variant="success">Terminé</twig:Badge>
                                                    {% else %}
                                                        <twig:Badge variant="warning">En cours</twig:Badge>
                                                    {% endif %}
                                                </button>
                                            </form>
                                        {% else %}
                                            {% if ticket.isDone %}
                                                <twig:Badge variant="success">Terminé</twig:Badge>
                                            {% else %}
                                                <twig:Badge variant="warning">En cours</twig:Badge>
                                            {% endif %}
                                        {% endif %}
                                    </div>

                                    <div class="flex items-center gap-1.5 text-xs {{ ticket.isOverdue ? 'font-medium text-red-600 dark:text-red-400' : 'text-muted-foreground' }}"
                                         {% if ticket.isOverdue %}title="Échéance dépassée"{% endif %}>
                                        <twig:ux:icon name="lucide:calendar" class="size-3.5 shrink-0" aria-hidden="true" />
                                        <span class="tabular-nums">{{ ticket.dueDate ? ticket.dueDate|date('d/m/Y') : '—' }}</span>
                                        {% if ticket.isOverdue %}
                                            <twig:ux:icon name="lucide:alarm-clock" class="size-3.5 shrink-0" aria-hidden="true" />
                                            <span class="sr-only">En retard</span>
                                        {% endif %}
                                    </div>

                                    <div class="ml-auto flex items-center gap-0.5 lg:ml-0 lg:justify-end">
                                        {% if is_granted('TICKET_EDIT', ticket) %}
                                            <twig:Button as="a" href="{{ path('ticket.edit', {id: ticket.id}) }}"
                                                         variant="ghost" size="icon" title="Modifier"
                                                         class="size-8 opacity-60 group-hover:opacity-100">
                                                <twig:ux:icon name="lucide:pencil" class="size-3.5" />
                                            </twig:Button>
                                        {% else %}
                                            <span title="Vous n'avez pas les droits pour modifier ce ticket">
                                                <twig:Button variant="ghost" size="icon" disabled
                                                             class="size-8 cursor-not-allowed opacity-30">
                                                    <twig:ux:icon name="lucide:pencil" class="size-3.5" />
                                                </twig:Button>
                                            </span>
                                        {% endif %}

                                        {% if is_granted('TICKET_DELETE', ticket) %}
                                            <twig:AlertDialog id="delete-dialog-{{ ticket.id }}">
                                                <twig:AlertDialog:Trigger>
                                                    <twig:Button variant="ghost" size="icon" title="Supprimer"
                                                                 class="size-8 text-destructive opacity-60 hover:text-destructive group-hover:opacity-100"
                                                                 {{ ...alert_dialog_trigger_attrs }}>
                                                        <twig:ux:icon name="lucide:trash-2" class="size-3.5" />
                                                    </twig:Button>
                                                </twig:AlertDialog:Trigger>

                                                <twig:AlertDialog:Content>
                                                    <twig:AlertDialog:Header>
                                                        <twig:AlertDialog:Title>Supprimer ce ticket ?</twig:AlertDialog:Title>
                                                        <twig:AlertDialog:Description>
                                                            Cette action est <strong>irréversible</strong>. Le ticket
                                                            « {{ ticket.name }} » sera définitivement supprimé.
                                                        </twig:AlertDialog:Description>
                                                    </twig:AlertDialog:Header>

                                                    <twig:AlertDialog:Footer>
                                                        <form method="post"
                                                              action="{{ path('ticket.delete', {id: ticket.id}) }}"
                                                              class="flex w-full justify-end gap-2">
                                                            <input type="hidden" name="_token"
                                                                   value="{{ csrf_token('delete' ~ ticket.id) }}">

                                                            <twig:AlertDialog:Cancel>Annuler</twig:AlertDialog:Cancel>

                                                            <twig:AlertDialog:Action type="submit"
                                                                class="bg-destructive text-white hover:bg-destructive/90">
                                                                Oui, supprimer
                                                            </twig:AlertDialog:Action>
                                                        </form>
                                                    </twig:AlertDialog:Footer>
                                                </twig:AlertDialog:Content>
                                            </twig:AlertDialog>
                                        {% else %}
                                            <span title="Seul le propriétaire ou un administrateur peut supprimer ce ticket">
                                                <twig:Button variant="ghost" size="icon" disabled
                                                             class="size-8 cursor-not-allowed opacity-30">
                                                    <twig:ux:icon name="lucide:trash-2" class="size-3.5" />
                                                </twig:Button>
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {# Pagination (shadcn) #}
        {% if pagination.paginationData.pageCount > 1 %}
            <div class="mt-6 flex justify-center">
                <twig:Pagination>
                    <twig:Pagination:Content>
                        <twig:Pagination:Item>
                            {% if pagination.paginationData.previous is defined %}
                                <twig:Pagination:Previous href="{{ path('ticket.index', filterParams|merge({page: pagination.paginationData.previous})) }}" />
                            {% else %}
                                <twig:Pagination:Previous href="#" class="pointer-events-none opacity-50" />
                            {% endif %}
                        </twig:Pagination:Item>

                        {% for page in pagination.paginationData.pagesInRange %}
                            <twig:Pagination:Item>
                                {% if page == pagination.currentPageNumber %}
                                    <twig:Pagination:Link href="{{ path('ticket.index', filterParams|merge({page: page})) }}" active>{{ page }}</twig:Pagination:Link>
                                {% else %}
                                    <twig:Pagination:Link href="{{ path('ticket.index', filterParams|merge({page: page})) }}">{{ page }}</twig:Pagination:Link>
                                {% endif %}
                            </twig:Pagination:Item>
                        {% endfor %}

                        <twig:Pagination:Item>
                            {% if pagination.paginationData.next is defined %}
                                <twig:Pagination:Next href="{{ path('ticket.index', filterParams|merge({page: pagination.paginationData.next})) }}" />
                            {% else %}
                                <twig:Pagination:Next href="#" class="pointer-events-none opacity-50" />
                            {% endif %}
                        </twig:Pagination:Item>
                    </twig:Pagination:Content>
                </twig:Pagination>
            </div>
        {% endif %}
    </div>
{% endblock %}
