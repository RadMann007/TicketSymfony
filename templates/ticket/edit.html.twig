{% extends 'layout/dashboard.html.twig' %}

{% block title %}Modifier un ticket{% endblock %}

{% block page_content %}
    <div class="mx-auto w-full max-w-2xl px-4 py-10">

        {# En-tête #}
        <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-3xl font-bold tracking-tight">Modifier le ticket</h1>
                    {% if ticket.isDone %}
                        <twig:Badge variant="success">Terminé</twig:Badge>
                    {% else %}
                        <twig:Badge variant="warning">En cours</twig:Badge>
                    {% endif %}
                    <twig:Badge variant="{{ ticket.priority.badgeVariant }}">Priorité {{ ticket.priority.label|lower }}</twig:Badge>
                    {% if ticket.isOverdue %}
                        <twig:Badge variant="destructive">En retard</twig:Badge>
                    {% endif %}
                </div>
                <p class="mt-2 text-sm text-muted-foreground">
                    Ticket #{{ ticket.id }} — créé le {{ ticket.createdAt|date('d/m/Y à H:i') }}
                    · assigné à
                    <span class="font-medium text-foreground">
                        {{ ticket.assignedTo ? ticket.assignedTo.email : 'personne' }}
                    </span>
                    · échéance
                    <span class="font-medium text-foreground">
                        {{ ticket.dueDate ? ticket.dueDate|date('d/m/Y') : 'aucune' }}
                    </span>
                </p>
            </div>
            <twig:Button as="a" href="{{ path('ticket.index') }}" variant="ghost" size="sm">
                <twig:ux:icon name="lucide:list" class="mr-1.5 size-4" aria-hidden="true" />
                Retour à la liste
            </twig:Button>
        </div>

        {# Messages flash #}
        {% for type, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="mb-6 flex items-start gap-3 rounded-lg border p-4 text-sm
                            {{ type == 'error'
                                ? 'border-red-200 bg-red-50 text-red-800'
                                : 'border-green-200 bg-green-50 text-green-800' }}">
                    <span class="text-lg leading-none">{{ type == 'error' ? '⚠️' : '✅' }}</span>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        {# Formulaire du ticket #}
        <div class="rounded-xl border bg-card p-6 shadow-sm">
            {{ form_start(form) }}

                <div class="mb-5 space-y-2">
                    {{ form_label(form.name, null, {
                        label_attr: { class: 'text-sm font-medium leading-none' }
                    }) }}

                    <twig:Input
                        id="{{ form.name.vars.id }}"
                        placeholder="Titre"
                        value="{{ form.name.vars.value }}"
                        name="{{ form.name.vars.full_name }}"
                    />

                    {{ form_errors(form.name) }}
                </div>

                <div class="mb-5 grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        {{ form_label(form.priority, null, {
                            label_attr: { class: 'text-sm font-medium leading-none' }
                        }) }}
                        {{ form_widget(form.priority, {
                            attr: {
                                class: 'flex h-9 w-full rounded-lg border border-input bg-transparent px-2.5 py-1 text-sm shadow-xs transition-colors outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 dark:bg-input/30'
                            }
                        }) }}
                        {{ form_errors(form.priority) }}
                    </div>

                    <div class="space-y-2">
                        {{ form_label(form.dueDate, null, {
                            label_attr: { class: 'text-sm font-medium leading-none' }
                        }) }}
                        {{ form_widget(form.dueDate, {
                            attr: {
                                class: 'flex h-9 w-full rounded-lg border border-input bg-transparent px-2.5 py-1 text-sm shadow-xs transition-colors outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 dark:bg-input/30'
                            }
                        }) }}
                        {{ form_errors(form.dueDate) }}
                        <p class="text-xs text-muted-foreground">{{ form.dueDate.vars.help }}</p>
                    </div>
                </div>

                <div class="mb-5 space-y-2">
                    {{ form_label(form.comment, null, {
                        label_attr: { class: 'text-sm font-medium leading-none' }
                    }) }}

                    <twig:Textarea
                        id="{{ form.comment.vars.id }}"
                        name="{{ form.comment.vars.full_name }}"
                        placeholder="Votre message"
                        rows="4"
                    >{{ form.comment.vars.value }}</twig:Textarea>

                    {{ form_errors(form.comment) }}
                </div>

                {% if form.assignedTo is defined %}
                    <div class="mb-5 space-y-2">
                        {{ form_label(form.assignedTo, null, {
                            label_attr: { class: 'text-sm font-medium leading-none' }
                        }) }}

                        {{ form_widget(form.assignedTo, {
                            attr: {
                                class: 'flex h-9 w-full rounded-lg border border-input bg-transparent px-2.5 py-1 text-sm shadow-xs transition-colors outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 dark:bg-input/30'
                            }
                        }) }}

                        {{ form_errors(form.assignedTo) }}
                    </div>
                {% endif %}

                <div class="mb-6">
                    <twig:Field:Group>
                        <twig:Field orientation="horizontal">
                            <twig:Checkbox
                                id="{{ form.isDone.vars.id }}"
                                name="{{ form.isDone.vars.full_name }}"
                                value="1"
                                :checked="form.isDone.vars.checked"
                            />
                            <twig:Field:Label for="{{ form.isDone.vars.id }}">
                                Marquer comme terminé
                            </twig:Field:Label>
                        </twig:Field>
                    </twig:Field:Group>
                    {{ form_errors(form.isDone) }}
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <twig:Button type="submit" variant="default">
                        Enregistrer les modifications
                    </twig:Button>
                    <twig:Button as="a" href="{{ path('ticket.index') }}" variant="outline">
                        Annuler
                    </twig:Button>
                </div>

                {{ form_widget(form._token) }}
            {{ form_end(form, {render_rest: false}) }}
        </div>

        {# Pièces jointes #}
        <section class="mt-6 overflow-hidden rounded-xl border bg-card shadow-sm">
            <div class="border-b px-5 py-4">
                <h2 class="text-base font-semibold">Pièces jointes</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    {{ ticket.attachments|length }} fichier{{ ticket.attachments|length > 1 ? 's' : '' }} · max 5 Mo
                </p>
            </div>

            <div class="px-5 py-4">
                <form method="post"
                      action="{{ path('ticket.attachment.upload', {id: ticket.id}) }}"
                      enctype="multipart/form-data"
                      class="flex flex-col gap-2 sm:flex-row sm:items-center">
                    <input type="hidden" name="_token" value="{{ csrf_token('attachment' ~ ticket.id) }}">
                    <input type="file" name="attachment" required
                           class="block w-full text-xs file:mr-3 file:rounded-md file:border-0 file:bg-primary file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-primary-foreground hover:file:bg-primary/90">
                    <twig:Button type="submit" size="sm" class="shrink-0">
                        <twig:ux:icon name="lucide:upload" class="mr-1.5 size-3.5" />
                        Envoyer
                    </twig:Button>
                </form>
            </div>

            {% if ticket.attachments is not empty %}
                <ul class="divide-y border-t">
                    {% for attachment in ticket.attachments %}
                        <li class="flex items-center justify-between gap-3 px-5 py-2.5">
                            <a href="{{ path('ticket.attachment.download', {id: attachment.id}) }}"
                               class="flex min-w-0 items-center gap-2 text-sm hover:underline">
                                <twig:ux:icon name="lucide:paperclip" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                                <span class="truncate">{{ attachment.originalName }}</span>
                                <span class="shrink-0 text-xs text-muted-foreground">{{ attachment.humanSize() }}</span>
                            </a>

                            {% if is_granted('TICKET_EDIT', ticket) %}
                                <form method="post"
                                      action="{{ path('ticket.attachment.delete', {id: attachment.id}) }}"
                                      class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('attachment_delete' ~ attachment.id) }}">
                                    <twig:Button variant="ghost" size="icon" type="submit" title="Supprimer"
                                                 class="size-7 text-destructive opacity-60 hover:opacity-100">
                                        <twig:ux:icon name="lucide:trash-2" class="size-3.5" />
                                    </twig:Button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# Historique #}
        <section class="mt-6 overflow-hidden rounded-xl border bg-card shadow-sm">
            <div class="border-b px-5 py-4">
                <h2 class="text-base font-semibold">Historique</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    {{ ticket.events|length }} événement{{ ticket.events|length > 1 ? 's' : '' }}
                </p>
            </div>

            {% if ticket.events is empty %}
                <div class="flex flex-col items-center gap-2 px-6 py-8 text-center">
                    <twig:ux:icon name="lucide:history" class="size-8 text-muted-foreground/40" aria-hidden="true" />
                    <p class="text-sm text-muted-foreground">Aucun événement pour le moment.</p>
                </div>
            {% else %}
                <ul class="divide-y">
                    {% for event in ticket.events %}
                        <li class="flex gap-3 px-5 py-3">
                            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">
                                {{ event.actor ? event.actor.email|slice(0, 1)|upper : 'S' }}
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">{{ event.label() }}</p>
                                <p class="mt-0.5 break-words text-xs text-muted-foreground">
                                    {% if event.oldValue is not null or event.newValue is not null %}
                                        {% if event.oldValue is not null and event.oldValue != '' %}
                                            <span class="line-through">{{ event.oldValue }}</span>
                                            <span class="mx-1">→</span>
                                        {% endif %}
                                        {{ event.newValue }}
                                        <span class="mx-1">·</span>
                                    {% endif %}
                                    {% if event.actor %}{{ event.actor.email }} · {% endif %}
                                    {{ event.createdAt|date('d/m/Y à H:i') }}
                                </p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# Commentaires #}
        <section class="mt-6 overflow-hidden rounded-xl border bg-card shadow-sm">
            <div class="border-b px-5 py-4">
                <h2 class="text-base font-semibold">Commentaires</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    {{ ticket.comments|length }}
                    message{{ ticket.comments|length > 1 ? 's' : '' }}
                </p>
            </div>

            {% if ticket.comments is empty %}
                <div class="flex flex-col items-center gap-2 px-6 py-10 text-center">
                    <twig:ux:icon name="lucide:inbox" class="size-10 text-muted-foreground/40" aria-hidden="true" />
                    <p class="text-sm text-muted-foreground">Aucun commentaire pour le moment.</p>
                </div>
            {% else %}
                <ul class="divide-y">
                    {% for comment in ticket.comments %}
                        <li class="flex gap-3 px-5 py-4">
                            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">
                                {{ comment.author.email|slice(0, 1)|upper }}
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center justify-between gap-1">
                                    <p class="text-sm font-medium">{{ comment.author.email }}</p>
                                    <time class="text-xs text-muted-foreground">
                                        {{ comment.createdAt|date('d/m/Y · H:i') }}
                                    </time>
                                </div>
                                <p class="mt-1 whitespace-pre-line text-sm text-muted-foreground">{{ comment.content }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="border-t bg-muted/20 px-5 py-4">
                {{ form_start(commentForm) }}

                    <div class="space-y-2">
                        {{ form_label(commentForm.content, null, {
                            label_attr: { class: 'text-sm font-medium leading-none' }
                        }) }}

                        <twig:Textarea
                            id="{{ commentForm.content.vars.id }}"
                            name="{{ commentForm.content.vars.full_name }}"
                            placeholder="Écrire un commentaire..."
                            rows="3"
                            required
                        >{{ commentForm.content.vars.value }}</twig:Textarea>

                        {{ form_errors(commentForm.content) }}
                    </div>

                    <div class="mt-3 flex justify-end">
                        <twig:Button type="submit" size="sm">
                            Publier
                        </twig:Button>
                    </div>

                    {{ form_widget(commentForm._token) }}
                {{ form_end(commentForm, {render_rest: false}) }}
            </div>
        </section>
    </div>
{% endblock %}
